{
  "manifest_version": 3,
  "name": "Tabstop",
  "version": "0.2.0",
  "description": "A keyboard-first new tab page for your bookmarks.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["bookmarks", "favicon", "topSites"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
